{
  "name": "blog",
  "private": true,
  "type": "module",
  "version": "0.0.1",
  "license": "ISC",
  "scripts": {
    "prepare": "simple-git-hooks",
    "dev": "astro dev",
    "start": "astro dev",
    "build": "astro check && astro build",
    "preview": "astro preview",
    "astro": "astro",
    "lint": "biome lint . --write",
    "format": "biome format . --write"
  },
  "prettier": {
    "tabWidth": 2,
    "endOfLine": "lf",
    "semi": false,
    "singleQuote": true,
    "trailingComma": "none"
  },
  "dependencies": {
    "@astrojs/check": "^0.9.8",
    "@astrojs/markdown-remark": "^7.1.0",
    "@astrojs/mdx": "^5.0.3",
    "@astrojs/rss": "^4.0.18",
    "@astrojs/sitemap": "^3.7.2",
    "@iconify-json/vscode-icons": "^1.2.45",
    "@unocss/reset": "^66.1.1",
    "@waline/client": "^3.13.0",
    "@yulania/progress": "^0.1.4",
    "astro": "^6.1.5",
    "typescript": "^5.9.3",
    "unocss": "^66.1.1"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.4.10",
    "@iconify-json/file-icons": "^1.2.2",
    "@iconify-json/logos": "^1.2.11",
    "@iconify-json/uil": "^1.2.3",
    "@types/node": "^22.19.15",
    "@yulania/compatibility-panel": "^0.0.1",
    "lightningcss": "^1.32.0",
    "lint-staged": "^16.4.0",
    "simple-git-hooks": "^2.13.1"
  },
  "lint-staged": {
    "*.{js,jsx,cjs,mjs,ts,tsx,cts,mts,astro}": "pnpm format & pnpm lint"
  },
  "simple-git-hooks": {
    "pre-commit": "pnpm lint-staged"
  },
  "packageManager": "pnpm@10.6.3",
  "pnpm": {
    "onlyBuiltDependencies": [
      "@biomejs/biome",
      "esbuild",
      "sharp",
      "simple-git-hooks"
    ]
  }
}
